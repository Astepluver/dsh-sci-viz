    "scientific-visualization",
    "bioinformatics",
    "protein-structure",
    "statistics",
    "research"
  ],
  "license": "MIT",
  "author": "Astepluver",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astepluver/dsh-sci-viz.git"
  },
  "homepage": "https://github.com/Astepluver/dsh-sci-viz#readme",
  "bugs": {
    "url": "https://github.com/Astepluver/dsh-sci-viz/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "data",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD-PARTY.md",
    "功能清单.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
